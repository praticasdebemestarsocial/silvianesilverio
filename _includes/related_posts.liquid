{% assign have_related_posts = false %}
{% assign max_related = site.related_blog_posts.max_related | default: 3 %}
{% for post in site.related_posts limit: max_related %}
  {% unless have_related_posts %}
    {% assign have_related_posts = true %}
    <br>
    <hr>
    <br>
    <ul class="list-disc pl-8"></ul>

    <!-- Adds related posts to the end of an article -->
    <h2 class="text-3xl font-semibold mb-4 mt-12">Gostou de ler este artigo?</h2>
    <p class="mb-2">Aqui estão mais alguns artigos que você pode gostar de ler em seguida:</p>
    <ul class="list-disc pl-8">
  {% endunless %}
  <li class="my-2">
    <a class="text-pink-700 underline font-semibold hover:text-pink-800" href="{{ site.baseurl }}{{ post.url }}">{{ post.title }}</a>
  </li>
{% endfor %}
{% if have_related_posts %}
    </ul>
{% endif %}
