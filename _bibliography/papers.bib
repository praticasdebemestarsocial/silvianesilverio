@article{Silverio2026Geometria,
  abbr              = {Zenodo},
  title             = {Geometria da Vitalidade: A Trama Iridológica e a Cartografia da Matriz Genético-Energética},
  author            = {Silvério, Silviane},
  abstract          = {Este depósito reúne a versão final do artigo “Geometria da Vitalidade: A Trama Iridológica e a Cartografia da Matriz Genético-Energética”, contendo texto completo, resumo, abstract, desenvolvimento teórico, conclusão e referências bibliográficas. O trabalho propõe uma reflexão morfossistêmica sobre a iridologia, articulando conceitos de terreno biológico, morfologia tecidual e sistemas complexos no campo das ciências da saúde integrativa. O material foi organizado em formato acadêmico para fins de divulgação científica, preservação digital e atribuição de DOI por meio da plataforma Zenodo.},
